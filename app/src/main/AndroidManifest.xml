<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- hľadanie zariadení v sieti: príjem UDP broadcastov aj keď telefón šetrí batériu -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- ovládanie PC: WiFi zámok s nízkou odozvou počas otvorenej obrazovky ovládania -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- automatika príchod/odchod: služba na pozadí, spustenie po reštarte, notifikácie -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- len na jednorazové zistenie polohy pre výpočet západu slnka (nepovinné, nie na pozadí) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- len na naskenovanie QR kódu pri pripojení k domácnosti (Android sa spýta až vtedy) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Domov"
        android:supportsRtl="true"
        android:theme="@style/Theme.Domov">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ovládanie PC z telefónu (obraz, myš, klávesnica): otáča sa bez reštartu spojenia -->
        <activity
            android:name=".PcRemoteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DomovWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/domov_widget_info" />
        </receiver>

        <!-- widget Nákup (od 1.44): malý 2×2 a zoznam 4×3 -->
        <receiver
            android:name=".ShoppingWidgetSmall"
            android:exported="false"
            android:label="@string/shop_widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shop_widget_small_info" />
        </receiver>

        <receiver
            android:name=".ShoppingWidgetLarge"
            android:exported="false"
            android:label="@string/shop_widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shop_widget_large_info" />
        </receiver>

        <receiver
            android:name=".DnesWidgetProvider"
            android:exported="false"
            android:label="@string/dnes_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dnes_widget_info" />
        </receiver>

        <service
            android:name=".SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".ChatJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- rýchle pridanie z widgetu Nákup: malé okno nad plochou, samostatná úloha mimo zoznamu posledných aplikácií -->
        <activity
            android:name=".ShoppingQuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Domov.QuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <service
            android:name=".PresenceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <service
            android:name=".BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- skener QR kódu (zxing-android-embedded): na výšku aj na šírku -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:exported="false"
            tools:replace="screenOrientation" />

        <receiver
            android:name=".FryerReceiver"
            android:exported="false" />

        <receiver
            android:name=".EventsReceiver"
            android:exported="false" />

        <!-- ranný prehľad: vlastný budík a prepočet po zmene času / časového pásma (systémové vysielania) -->
        <receiver
            android:name=".MorningBriefReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PresenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
