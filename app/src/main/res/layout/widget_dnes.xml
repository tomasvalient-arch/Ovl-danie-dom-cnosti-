<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dnes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shop_widget_bg"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:id="@+id/dnes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dnes"
                android:textColor="@color/shop_widget_text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dnes_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shop_widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/dnes_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/shop_widget_add_bg"
            android:contentDescription="Pridať udalosť">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shop_add" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dnes_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shop_widget_text"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/dnes_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shop_widget_text"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/dnes_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shop_widget_text"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/dnes_line4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shop_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dnes_shop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shop_widget_accent"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
